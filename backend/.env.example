# Copy this file to ".env" (same folder) and put your own values.
# ".env" is ignored by git. Never commit real passwords or secrets.

# Local MySQL or TiDB Cloud Serverless URL
DATABASE_URL=jdbc:mysql://localhost:3306/campusfix?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DATABASE_USERNAME=root
DATABASE_PASSWORD=change-me

# Alternative standard Spring environment variables for cloud deployment (e.g. Render):
# SPRING_DATASOURCE_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/campusfix?sslMode=VERIFY_IDENTITY
# SPRING_DATASOURCE_USERNAME=xxxxxx.root
# SPRING_DATASOURCE_PASSWORD=xxxxxx

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-of-32-plus-chars
JWT_EXPIRATION=86400000

# Cloudinary (Optional: Recommended for free cloud hosting on Render where disk is ephemeral)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional
# PORT=8080
# DDL_AUTO=validate
# UPLOAD_DIR=uploads
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
# ESCALATION_CHECK_INTERVAL_MS=3600000
